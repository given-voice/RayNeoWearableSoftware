<?xml version="1.0" encoding="utf-8"?>
<!--
  Extends the original single-list layout with:
  - urgentButton: fixed at the top, never scrolls away, always visible
    regardless of which screen (situation picker or phrase list) is showing.
    This is the "Equipment issue" shortcut — it must not depend on how deep
    the user has navigated.
  - screenTitle: shows which screen is active ("Choose a situation" /
    the situation name) so it's clear during testing which level of the
    hierarchy is on screen.
  - phraseContainer: reused for BOTH the situation list and the phrase
    list — MainActivity swaps its contents depending on navigation state,
    rather than using two separate layouts.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000">

    <Button
        android:id="@+id/urgentButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:backgroundTint="#B00020"
        android:text="⚠ Equipment issue"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <TextView
        android:id="@+id/screenTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/urgentButton"
        app:layout_constraintLeft_toLeftOf="parent" />

    <ScrollView
        android:id="@+id/scrollContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/screenTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <LinearLayout
            android:id="@+id/phraseContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp" />

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>